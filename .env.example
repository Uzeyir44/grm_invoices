# Operating mode: development (default) or production.
# Production deployments MUST set DJANGO_ENV=production. In production mode
# Django fails closed during startup on missing/insecure configuration, and
# .env is NOT read — every value below must come from the deployment
# environment itself.
DJANGO_ENV=development

# SECURITY: DEBUG must be False in production. In production mode the process
# refuses to start if DJANGO_DEBUG is truthy, and a missing value defaults to
# False (fail closed).
DJANGO_DEBUG=True

# SECURITY: keep the secret key used in production secret!
# In production mode a strong key is REQUIRED: at least 50 characters and it
# must not start with 'django-insecure-' (Django refuses to start otherwise).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production

# SECURITY: comma-separated list of host/domain names Django is allowed to
# serve. Required in production (never '*').
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Django's internal/emergency admin. Defaults to enabled in development and
# disabled in production. It is not the React System Admin interface.
DJANGO_ADMIN_ENABLED=True

# Complete browser origins allowed to make CSRF-protected requests. Bearer-only
# API requests do not use CSRF, but list the frontend origin when Django admin
# or cookie-based browser requests are deployed separately.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to True ONLY when TLS is terminated at a reverse proxy / load balancer
# in front of Django, so Django trusts the proxy's "X-Forwarded-Proto" header.
# Never enable this when clients can reach Django directly.
DJANGO_TRUST_PROXY_SSL_HEADER=False

# JWT (optional; falls back to DJANGO_SECRET_KEY when unset)
JWT_SIGNING_KEY=change-me-in-production

# PostgreSQL
DB_NAME=grm_crm
DB_USER=grm_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# DOCX -> PDF conversion (document generation Step 4.5)
# Path to a LibreOffice 'soffice' binary; leave empty to auto-discover.
LIBREOFFICE_PATH=
# Maximum seconds a single DOCX -> PDF conversion may take (default 120).
PDF_CONVERSION_TIMEOUT=120

# System Admin backups (Phase 9)
# Path to the 'pg_dump' binary used for application-triggered database backups.
# Leave empty to auto-discover via PATH; pin an explicit path when pg_dump is
# not on PATH (e.g. C:\Program Files\PostgreSQL\<version>\bin\pg_dump.exe).
# When no binary resolves, database backups are reported as unavailable.
PG_DUMP_PATH=
# Directory that stores backup artifacts. It must live OUTSIDE MEDIA_ROOT and
# must never be web-served. Defaults to <project>/backup_storage.
BACKUP_ROOT=
# Maximum seconds a single backup creation may take (default 300).
BACKUP_CREATION_TIMEOUT=300

# Request / resource limits (application-level guards; defaults shown).
# Maximum size (bytes) of an uploaded .docx template file (default 5 MB).
MAX_TEMPLATE_FILE_SIZE=5242880
# Maximum number of line items allowed in a single generated-document create
# request; oversized requests are rejected with 400 before generation runs.
MAX_DOCUMENT_LINE_ITEMS=500
# Maximum HTTP request body size (bytes); larger Content-Length is rejected
# with 413 by Django before any processing. Default 10 MB.
MAX_REQUEST_BODY_SIZE=10485760

# API throttling (DRF ScopedRateThrottle, opt-in per endpoint).
# Authenticated scopes rate per user; login/refresh rate per client IP.
# DRF relies on Django's cache — use a shared cache backend (e.g. Redis) in
# multi-worker production deployments for consistent throttling.
DRF_THROTTLE_AUTH_LOGIN=10/min
DRF_THROTTLE_TOKEN_REFRESH=20/min
DRF_THROTTLE_ADMIN_LOGIN=5/min
DRF_THROTTLE_ADMIN_REFRESH=10/min
DRF_THROTTLE_DOCUMENT_CREATION=60/hour
DRF_THROTTLE_DOCUMENT_GENERATION=30/hour
DRF_THROTTLE_PDF_GENERATION=30/hour
